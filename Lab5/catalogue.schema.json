{
    "type": "object", 
    "properties": {
        "isbn": {
        "type": "string",
        "const": 13
        },  
        "title": {
            "type": "string", 
            "minLength": 1
        },
        "authors": {
            "type": "array",
            "minItems": 1
        }, 
        "year": {
            "type": "number", 
            "minimum": 1450,
            "maximum": 2025
        },
        "format": {
            "enum": ["hardcover", "paperback", "ebook", "audiobook"]
        }, 
        "available": {
            "type": "boolean"
        }
    },
    "required": ["isbn", "title", "authors", "year", "format"]
}